{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin/print/(.*)", "destination": "/certificate-template.html" },
    { "source": "/admin/dashboard", "destination": "/admin-dashboard.html" },
    { "source": "/admin/login", "destination": "/admin-login.html" },
    { "source": "/admin", "destination": "/admin-login.html" },
    { "source": "/track", "destination": "/track.html" },
    { "source": "/request", "destination": "/request.html" }
  ]
}
