# ==============================================================
# Barangay E-Certificate Portal: Environment Configuration
# Location: Barangay Concepcion, Valencia City, Bukidnon
# ==============================================================

PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Security
JWT_SECRET=barangay_concepcion_valencia_secure_jwt_token_2026_xyz

# Database Driver: 'firestore' (Cloud), 'sqlite' (Zero-config local), or 'mysql'
DB_CLIENT=sqlite

# Firebase Cloud Configuration (used when DB_CLIENT=firestore)
FIREBASE_PROJECT_ID=brgy-concepcion-valencia
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
FIREBASE_WEB_API_KEY=AIzaSyDYRXWvM5LJPcHJiWu7K1FlCJnVJ4aYbRs
FIREBASE_AUTH_DOMAIN=brgy-concepcion-valencia.firebaseapp.com

# MySQL Database Settings (used when DB_CLIENT=mysql)
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=barangay_concepcion_db
DB_PORT=3306

# SQLite Database Settings (used when DB_CLIENT=sqlite)
SQLITE_DB_PATH=./data/barangay_concepcion.sqlite

# SMS Integration: Semaphore API (https://semaphore.co)
# In local development or testing, leave as 'MOCK_DEV_KEY' or SMS_SIMULATION_MODE=true
SEMAPHORE_API_KEY=MOCK_DEV_KEY
SEMAPHORE_SENDER_NAME=BRGYCONCEP
SMS_SIMULATION_MODE=true

# Resend Email Integration (https://resend.com) - 3,000 Free Transactional Emails/Month
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Barangay Concepcion <onboarding@resend.dev>
RESEND_SIMULATION_MODE=false

# Official Barangay Jurisdiction Information
BARANGAY_NAME=Barangay Concepcion
CITY_NAME=Valencia City
PROVINCE_NAME=Bukidnon
PUNONG_BARANGAY=Hon. Merlyn G. Antiga
BARANGAY_SECRETARY=Hon. Redin T. Butanas
OFFICE_HOURS=Monday - Friday, 8:00 AM - 5:00 PM
BARANGAY_HOTLINE=0906-182-2959 / 0930-707-2544
BARANGAY_EMAIL=concepcion66barangay@gmail.com
BARANGAY_HALL_ADDRESS=Barangay Hall, Purok 3, Concepcion, Valencia City, Bukidnon
